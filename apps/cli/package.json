{
  "name": "resimantle",
  "version": "0.1.0",
  "description": "CLI for ResiMantle - Adaptive security resin",
  "bin": {
    "resimantle": "./dist/bin/resimantle.js"
  },
  "private": true,
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/bin/resimantle.js"
  },
  "dependencies": {
    "@resimantle/core": "workspace:*",
    "@resimantle/types": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
